{
  "manifest_version": 3,
  "name": "AdClear",
  "version": "1.0.0",
  "description": "Lightweight browser ad filtering for supported websites.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://*.spotify.com/*",
    "*://*.scdn.co/*",
    "*://*.soundcloud.com/*",
    "*://*.sndcdn.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.googletagservices.com/*",
    "*://*.adnxs.com/*",
    "*://*.adsrvr.org/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://open.spotify.com/*",
        "*://soundcloud.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AdClear",
    "default_popup": "popup.html"
  },
  "icons": {}
}